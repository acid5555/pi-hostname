{
  "name": "pi-hostname",
  "version": "1.0.0",
  "description": "Pi extension that tracks hostname context for cross-machine session sharing",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "install:local": "npm run build && cp dist/extension.js ~/.pi/agent/extensions/pi-hostname/index.js"
  },
  "devDependencies": {
    "@mariozechner/pi-coding-agent": "file:/home/will/.local/share/mise/installs/node/24.11.1/lib/node_modules/@mariozechner/pi-coding-agent",
    "oxfmt": "^0.28.0",
    "oxlint": "^1.43.0",
    "typescript": "^5.6.0",
    "ultracite": "^7.1.3"
  },
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  }
}
